CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LVGL_PORT_BUF_PSRAM=y
CONFIG_LVGL_PORT_AVOID_TEAR_ENABLE=y
CONFIG_LVGL_PORT_AVOID_TEAR_MODE_3=y

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# BSP rotates the framebuffer AND GT911 touch coordinates.
CONFIG_LVGL_PORT_ROTATION_90=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_18=y

# Display/touch bring-up, UI rendering and network setup exceed IDF's 3584-byte default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# UI creation exceeds LVGL's 32 KiB default pool. Use the board's 8 MiB PSRAM.
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="controller_lvgl_memory.h"

# Keep large UI data and TLS contexts out of internal RAM needed by DMA/crypto.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# RGB scanout shares PSRAM with rotation, TLS and network parsing. Keep the
# bounce refill ISR supplied and caches available across NVS/flash writes.
CONFIG_LCD_RGB_BOUNCE_BUFFER_HEIGHT=20
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Chunky transport and volume symbols.
CONFIG_LV_FONT_MONTSERRAT_48=y

# Bundled offline boot/sleep splash image.
CONFIG_LV_USE_PNG=y
