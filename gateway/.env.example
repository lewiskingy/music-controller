# Copy to .env; keep private. Use a dedicated non-admin Music Assistant account.
MA_WS_URL=http://host.docker.internal:8095/ws
MA_USERNAME=controller
MA_PASSWORD=REPLACE_WITH_MUSIC_ASSISTANT_PASSWORD
CONTROLLER_DEVICE_TOKEN=REPLACE_WITH_RANDOM_DEVICE_TOKEN
# Exact browser origin, without a trailing slash. Empty disables browser access.
CONTROLLER_ORIGIN=https://controller.example.net
# Optional example frontend. Set these even for Compose configuration validation.
CONTROLLER_HOST=controller.example.net
MA_HTTP_UPSTREAM=host.docker.internal:8095
# LAN address of your server. The default exposes the frontend only to localhost.
CONTROLLER_BIND_IP=127.0.0.1
